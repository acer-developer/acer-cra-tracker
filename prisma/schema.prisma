// Data model mirrors the shape reverse-engineered from the reference product's
// /rating-actions and /stats/summary responses. One row per rating action.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Supabase pooled (port 6543, pgbouncer) for the app
  directUrl = env("DIRECT_URL")     // Supabase direct (port 5432) for db push / migrations
}

enum Agency {
  CRISIL
  CARE
  ICRA
  INDIA_RATINGS
  INFOMERICS
  ACUITE
  BRICKWORK
}

enum Band {
  good
  warning
  serious
  critical
  unknown
}

model Entity {
  id        String         @id @default(uuid())
  name      String         @unique
  cin       String?
  actions   RatingAction[]
  createdAt DateTime       @default(now())

  @@index([name])
}

model RatingAction {
  id               String    @id @default(uuid())
  entity           Entity    @relation(fields: [entityId], references: [id])
  entityId         String
  entityName       String
  agency           Agency
  ratingDate       DateTime?
  ratingAction     String
  isInc            Boolean   @default(false)
  superseded       Boolean   @default(false)
  topRatingString  String?
  topGrade         String?
  band             Band      @default(unknown)
  topAmountCr      Float?
  auditCoverage    String?
  sourceUrlPrimary String
  sourceUrlDisplay String?
  dedupeKey        String    @unique
  ingestedAt       DateTime  @default(now())

  @@index([agency])
  @@index([ratingDate])
  @@index([ratingAction])
  @@index([superseded])
}

model IngestRun {
  id           String    @id @default(uuid())
  agency       Agency
  mode         String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  pagesRead    Int       @default(0)
  pdfsFound    Int       @default(0)
  rowsUpserted Int       @default(0)
  errors       Int       @default(0)
  lastError    String?

  @@index([agency, startedAt])
}
