# --- Supabase Postgres ---
# Supabase dashboard -> Project Settings -> Database -> Connection string.
#
# DATABASE_URL = "Connection pooling" (Transaction mode, port 6543). Append the
# pgbouncer flags so Prisma behaves on serverless (Vercel). Used by the app.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = the direct connection (port 5432). Used by `prisma db push` /
# migrations and by the Python scraper (it opens its own connection).
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# On Vercel: add BOTH as Environment Variables.
# On GitHub Actions (scraper): add DIRECT_URL as the secret named DATABASE_URL.
